{
  // Top Down Heat online server — deploy with:  npx wrangler deploy
  "name": "tdh-online",
  "main": "index.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
